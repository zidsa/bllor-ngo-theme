{#
  NCNP fundraising licence of one donation product. Expects `product` and `licence_view`:
  'icon' (the verified seal placed after the product name, on the card and the product
  page) or 'details' (the status and licence details next to the donation controls).

  The licence comes from extension-backend's NCNP integration, in the product meta:
  - `ncnp_licence_number`: set only when the product is linked to an NCNP program.
  - `ncnp_end_date`: last collecting day, "YYYY-MM-DD" (Riyadh calendar day).

  The backend refuses to publish, and hourly hides, products whose licence is not
  active, so a visible linked product has a valid licence. Pages may be cached, so
  js.js still removes the status once the end date has passed. Unlinked products
  render nothing: no badge, no warning.
#}
{% set ncnp_meta = product.meta or {} %}
{% set ncnp_number = ncnp_meta.ncnp_licence_number %}
{% set ncnp_is_donation = product.product_class in ['crowdfunding_project', 'donation_item'] %}
{% if ncnp_is_donation and ncnp_number %}
    {% set ncnp_end = ncnp_meta.ncnp_end_date or '' %}

    {# Verified seal, inline so it needs no asset and has no background. On the card it
       sits after the product name with a tooltip (hover, focus or tap) set up by js.js;
       Bootstrap mounts the tooltip on <body>, so the card's overflow:hidden does not clip it. #}
    {% set ncnp_icon %}<svg class="ncnp-licence-seal" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>{% endset %}

    {% if licence_view == 'details' %}
        <div class="ncnp-licence ncnp-licence-details" data-ncnp-licence data-end="{{ ncnp_end }}">
            <p class="ncnp-licence-head">{{ ncnp_icon }}<span>{{ _('Valid fundraising licence') }}</span></p>
            <details class="ncnp-licence-more">
                <summary class="ncnp-licence-summary">
                    {{ _('Licence details') }}
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </summary>
                <dl class="ncnp-licence-body">
                    <div class="ncnp-licence-row">
                        <dt>{{ _('Licence number') }}</dt>
                        <dd dir="ltr">{{ ncnp_number | e }}</dd>
                    </div>
                    {% if ncnp_end %}
                        <div class="ncnp-licence-row">
                            <dt>{{ _('Valid until') }}</dt>
                            <dd dir="ltr">{{ ncnp_end | e }}</dd>
                        </div>
                    {% endif %}
                </dl>
                <div class="ncnp-licence-issuer">
                    <p class="ncnp-licence-issuer-name">{{ _('National Center for Non-Profit Sector') }}</p>
                    <img class="ncnp-licence-logo" src="{{ 'ncnp-logo.png' | asset_url }}" alt="{{ _('National Center for Non-Profit Sector') }}" width="400" height="178" loading="lazy">
                </div>
            </details>
        </div>
    {% else %}
        <button type="button" class="ncnp-licence ncnp-licence-icon" data-ncnp-licence data-end="{{ ncnp_end }}"
                data-ncnp-tooltip data-ncnp-title="{{ _('Valid fundraising licence') }}"
                aria-label="{{ _('Valid fundraising licence') }}">{{ ncnp_icon }}</button>
    {% endif %}
{% endif %}
