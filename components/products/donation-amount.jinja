{# Amount picker. The amount is the quantity: a 1-SAR product added `amount` times.
   Expects `input_id`, and optionally `max_amount` (remaining amount to raise). #}
<div class="donation-amount">
    <label class="form-label" for="{{ input_id }}">{{ _('Donation amount') }}</label>
    <div class="row g-1">
        <div class="col-6">
            <div class="h-100 d-flex gap-2 w-100 justify-content-between donation-amount-options">
                {% for amount in (donate_money_list | map(attribute='amount') | list if donate_money_list else [10, 50, 100]) %}
                    <button class="button-price {{ 'active' if loop.first }}" type="button" data-target="#{{ input_id }}" data-price="{{ amount }}">{{ amount }}</button>
                {% endfor %}
            </div>
        </div>
        <div class="col-6">
            <div class="input-amount wrapper--input-amount">
                <input type="text" inputmode="numeric" value="{{ donate_default_money }}" id="{{ input_id }}" class="donation-input"
                       aria-label="{{ _('Other amount') }}" {% if max_amount %}data-max="{{ max_amount }}"{% endif %}><span>{{ safeget(store, 'settings.general.currency.symbol', '') }}</span>
            </div>
        </div>
    </div>
</div>
