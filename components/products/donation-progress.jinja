{# Collected / remaining figures and the progress bar for one donation product.
   project_collected_amount already includes offline (external) donations, so it is
   shown as is. The explicit amounts are null when the merchant hides them. #}
{% set meta = product.meta or {} %}
{% set is_project = product.product_class == 'crowdfunding_project' %}
{% set pct = meta.project_progress_percentage if is_project else meta.progress_percentage %}
{% set show_figures = (meta.show_collected_amount if is_project else meta.show_purchased_units) and not meta.is_open_donation %}
{% set show_bar = meta.show_progress_bar and pct is not none and not meta.is_open_donation %}
{% set show_pct = show_bar and meta.show_progress_percentage %}
{% set unit = product.currency_symbol if is_project else _('units') %}
{% set collected = meta.project_collected_amount if is_project else meta.purchased_units %}
{% set remaining = meta.project_remaining_amount if is_project else meta.remaining_units %}
{% set goal = meta.project_goal_amount if is_project else meta.total_units %}
<div class="progress-product {{ '' if show_figures or show_bar else 'p-0' }}">
    {% if (show_figures and collected is not none) or show_pct %}
        <div class="progress-summary">
            {% if show_figures and collected is not none %}
                <p class="progress-collected">
                    <span class="large">{{ collected }} {{ unit }}</span>
                    <span class="progress-muted">
                        {%- if goal -%}
                            {{ _('of %s') | format(goal ~ ' ' ~ unit) }}
                        {%- else -%}
                            {{ _('Collected') if is_project else _('Supported') }}
                        {%- endif -%}
                    </span>
                </p>
            {% endif %}
            {% if show_pct %}
                <span class="progress-pct">{{ ('%.1f' | format(pct)).rstrip('0').rstrip('.') }}%</span>
            {% endif %}
        </div>
    {% endif %}
    {% if show_bar %}
        {# The percentage sits above the bar: inside a short bar it does not fit. #}
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: {{ [pct, 100] | min }}%" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    {% endif %}
    {% if show_figures and remaining is not none %}
        <p class="progress-remaining">{{ _('Remaining amount') if is_project else _('Remaining') }}: <strong>{{ remaining }} {{ unit }}</strong></p>
    {% endif %}
</div>
