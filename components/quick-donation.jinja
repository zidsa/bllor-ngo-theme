{# Floating quick donation button. Donates to the store's system-managed
   "zid-quick-donation" product (an open donation_item created by extension-backend).
   Shown only when the store enables quick donation. #}
{% set qd_amounts = settings.quick_donate_list_money | default([], true) %}
{% set qd_color = settings.quick_donate_main_btn_bg_color | default('var(--primary-color)', true) %}
{% set currency_symbol = safeget(store, 'settings.general.currency.symbol', '') %}
<link rel="stylesheet" href="{{ 'quick-donation.css' | asset_url }}">
<div id="containerForm" class="end-0" data-quick-donation>
    <button id="quickDonateBtn" type="button" style="--bg:{{ qd_color }};--color:#fff" class="btn d-flex align-items-center gap-1 btn-primary" data-qd-toggle>
