{% extends "layout.jinja" %}

{# Each category shows its first opportunities. They are loaded from the category page
   itself, so the cards come from the same template as everywhere else. #}
{% block content %}
    <div class="container">
        <div class="page-content">
            {% with title = _('All categories'), crumbs = [] %}
                {% include 'components/breadcrumb.jinja' %}
            {% endwith %}
        </div>
    </div>
    <div class="container">
        {# Shown when there are no categories, or none of them has opportunities. #}
        <div class="empty-state {{ 'd-none' if categories }}" data-categories-empty>
            <span class="empty-state-icon" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
            <p class="empty-state-text">{{ _('No categories yet') }}</p>
            <a href="{{ '/products' | localized_url }}" class="btn btn-primary">{{ _('Browse donation opportunities') }}</a>
        </div>
        {% for category in categories %}
            {% set category_url = url_for('category_details', category_id=category.id, slug=category.slug) %}
            <div class="mb-4 d-none" data-category-block="{{ category_url }}">
                <a href="{{ category_url }}" class="block-category d-flex align-items-center justify-content-center" {% if category.cover_image %}style="background-image: url('{{ category.cover_image }}')"{% endif %}>
                    <span>{{ category.name | e }}</span>
                </a>
                <div class="mt-3 category-product category-item" data-category-cards></div>
                <div class="mt-3 text-center">
                    <a href="{{ category_url }}" class="btn btn-outline-primary">{{ _('More') }}</a>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block footer_scripts %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var blocks = document.querySelectorAll("[data-category-block]");
        var loads = Array.prototype.map.call(blocks, function (block) {
            return fetch(block.getAttribute("data-category-block"), { credentials: "same-origin" })
                .then(function (response) { return response.text(); })
                .then(function (html) {
                    var page = new DOMParser().parseFromString(html, "text/html");
                    var cards = Array.prototype.slice.call(page.querySelectorAll("[data-category-products] .row > .col-lg-4"), 0, 6);
                    if (!cards.length) return;
                    var row = document.createElement("div");
                    row.className = "row";
                    cards.forEach(function (card) { row.appendChild(document.importNode(card, true)); });
                    block.querySelector("[data-category-cards]").appendChild(row);
                    block.classList.remove("d-none");
                    if (window.bllorInitDonationWindows) window.bllorInitDonationWindows(block);
                })
                .catch(function () {});
        });
        Promise.all(loads).then(function () {
            if (blocks.length && !document.querySelector("[data-category-block]:not(.d-none)")) {
                document.querySelector("[data-categories-empty]").classList.remove("d-none");
            }
        });
    });
</script>
{% endblock %}
